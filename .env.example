HTTP_ADDR=:8080
METRICS_ADDR=127.0.0.1:9464
PUBLIC_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8080
DATABASE_URL=postgres://rollandplay:rollandplay@localhost:5432/rollandplay?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
SESSION_COOKIE_NAME=rollandplay_session
SESSION_TTL_HOURS=720
ACCESS_TOKEN_TTL_MINUTES=15
MAGIC_LINK_TTL_MINUTES=15
SMTP_ADDR=localhost:1025
SMTP_FROM=rollandplay@localhost
SMTP_USERNAME=
SMTP_PASSWORD=
ASSET_STORAGE_DIR=./var/assets
# Asset storage driver for new uploads: disk or s3. Assets already saved by either driver keep serving.
ASSET_STORAGE_DRIVER=disk
# S3-compatible bucket (Cloudflare R2): set these, switch the driver to s3, then run `go run ./cmd/migrate-assets`.
# S3_ENDPOINT=ACCOUNT_ID.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=rollandplay-assets
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PRESIGN_TTL_MINUTES=15
ROOM_PASSWORD_SALT=dev-only-salt
LOG_LEVEL=info
LOG_FORMAT=json
