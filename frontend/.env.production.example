# Same-origin production deployment. Leave blank when frontend and backend share one domain.
VITE_API_BASE_URL=
VITE_WS_BASE_URL=

# If frontend and backend are on different hosts, use explicit origins instead:
# VITE_API_BASE_URL=https://api.your-domain.example
# VITE_WS_BASE_URL=wss://api.your-domain.example
